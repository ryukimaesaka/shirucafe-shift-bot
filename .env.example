# ローカル検証用。実値を入れた .env はコミットしないこと（.gitignore済）。
# 本番は GitHub Secrets に同名で登録する。値はここに書かない（プレースホルダのみ）。

# --- ジョブカン 管理者ログイン（login.js のローカル手動ログイン用。CIでは使わない） ---
JOBCAN_COMPANY_ID=your-company-id
JOBCAN_LOGIN_ID=
JOBCAN_PASSWORD=

# --- GAS 集計キック（Web App doPost） ---
GAS_WEBAPP_URL=
RUN_SECRET=

# --- 失敗/遅刻通知 ---
SLACK_WEBHOOK_URL=

# --- セッション（base64のstorageState）。実値はGitHub Secret JC_STATE に入れる ---
JC_STATE=
